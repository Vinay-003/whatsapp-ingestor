# --- runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=10000
LOG_LEVEL=info

# --- source ------------------------------------------------------------------
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Va6I79K60eBfQ92DwH0W
# Bounded history backfill on start and every N minutes
HISTORY_BATCH_SIZE=25
HISTORY_BACKFILL_INTERVAL_MINUTES=60
# The server's live-update window is ~90s; re-subscribe well inside it.
LIVE_RESUBSCRIBE_SECONDS=60

# --- database ----------------------------------------------------------------
# Direct or pooler connection string. The ingestion service is the only writer.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 32-byte key, hex or base64. Used for AES-256-GCM on the stored session state.
SESSION_ENCRYPTION_KEY=
# Optional: keep a local copy of the session for fast cold starts / debugging
SESSION_LOCAL_DIR=./auth

# --- health ------------------------------------------------------------------
# Bearer token required by GET /health. Set the same value in the Cloudflare Worker.
HEALTH_PING_SECRET=

# --- single writer lease -----------------------------------------------------
LEASE_TTL_SECONDS=120
INSTANCE_ID=
