# Supabase — the anon key is safe to expose to the browser: Row Level
# Security decides what it can read, and only published jobs are readable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the admin moderation area.
ADMIN_PASSWORD=
